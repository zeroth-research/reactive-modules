
name = "{{ project_name }}"
version = "0.1.0"
defaultTargets = ["System", "Certificate"]

[[lean_lib]]
name = "Core"

[[lean_lib]]
name = "LeanAI"

[[lean_lib]]
name = "ZerothHammer"

[[lean_lib]]
name = "Certificate"

[[lean_lib]]
name = "System"
{% if na_lib %}

# `--fbk-proveit`: `proveit.py` compiles the NA model out of tree and so
# imports it under its bare file stem, which the certificate then names.
# Mapping that module name back onto the file is what lets `lake build`
# resolve the same import the certificate was generated against.
[[lean_lib]]
name = "{{ na_lib }}"
srcDir = "{{ proveit_dir }}"
{% endif %}

[[require]]
name = "cslib"
scope = "leanprover"
rev = "{{ cslib_rev }}"

[[require]]
name = "smt"
git = "https://github.com/ufmg-smite/lean-smt.git"
rev = "f58d19d5d0803fcccb5ccb1b4473774dd2ae9f9a"
{% if ltl_project %}

# `--fbk-proveit`: the certificate imports LTLCertifying.*. A path require
# rather than a git one because the route already has the checkout in hand,
# and because that checkout pins cslib and smt to the revisions above — the
# two package sets resolve as one.
[[require]]
name = "LTL_Certifying"
path = "{{ ltl_project }}"
{% endif %}

#[[require]]
#name = "mylib"
#git = "https://github.com/zeroth/proof-prototyping"
#rev = "main"
{% if executable %}

[[lean_exe]]
name = "main"
root = "Main"
{% endif %}
