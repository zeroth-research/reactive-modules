=== Certificate/Data.lean
import Core.Basic

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Mat Real 1 1) → Prop := fun s => ((s 0 0) ≤ (5 : Real))

def P : (Mat Real 1 1) → Prop := fun s => ((s 0 0) ≤ (5 : Real))

noncomputable instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance


=== Certificate/Certificate.lean
import Mathlib.Algebra.BigOperators.Fin
import Core.Basic
import System.System
import Certificate.Data
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

-- Budgets and tactics below are generated from the shape of this module and
-- its certificate; see `zrth/lean/proof/tactics.py`.
-- state: Real, 1 slot(s), 3 term(s)
-- predicates: flat, linear
set_option maxRecDepth 4500
set_option maxHeartbeats 2000000

noncomputable def RM : ReactiveModule ((Unit) × (Unit)) ((Mat Real 1 1)) := {
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
}

-- Reduce matrix arithmetic on the goal only (avoids exponential blowup on hypotheses)
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, c0, c1, MatAdd_apply, MatMul_apply, MatZero_apply, Pi.add_apply, mul_Mat_apply, add_Mat_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold definitions everywhere (cheap: no matrix arithmetic reduction)
-- Gives omega/decide access to invariant and property conditions in hypotheses
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, c0, c1] at *; try dsimp at *))

-- Canonicalise the goal: only the steps this module's shapes call for.
macro "cert_prep" : tactic =>
  `(tactic| ((try norm_num at *)))

-- Close it: only the provers this state can use, cheapest first.
macro "cert_close" : tactic =>
  `(tactic| first | contradiction | linarith | (norm_cast; linarith) | (norm_num; done) | (constructor <;> first | linarith) | tauto | (simp_all; done) | (simp_all; linarith) | (simp_all; norm_num; done) | lra_close)

-- Enumerate the state, when it is finite and narrow enough to be worth it.
-- `skip` otherwise. Takes the obligation's own state binder.
macro "cert_states" v:ident : tactic =>
  `(tactic| (skip))

-- Branch conditions cvc5 decided under the invariant, so `split_ifs` does
-- not have to. `skip` unless --smt-tactics=cvc5 found some. Takes the
-- obligation's own state binder; every step is `try`.
macro "cert_facts" v:ident : tactic =>
  `(tactic| (skip))

-- Bridge each floored quantity to a bound on the Real under it, so the
-- closers see the `Int` atom with a sign. `skip` when nothing is floored.
-- Takes the obligation's own state binder; every step is `try`.
macro "cert_floors" v:ident : tactic =>
  `(tactic| (skip))

-- Hypotheses no refutation needed. `skip` otherwise.
macro "cert_thin" : tactic =>
  `(tactic| (skip))

-- Collapse Mat 1 1 types to scalars everywhere (cheap: no Fin.sum_univ)
-- Rewrites Mat 1 1 comparisons, ite through functions, Bool/decide normalization
macro "mat_collapse" : tactic =>
  `(tactic| simp only [Mat_1_1_lt_iff, Mat_1_1_le_iff, Mat_1_1_eq_iff, Mat_1_1_ne_iff,
                        ite_fun_apply,
                        decide_eq_true_eq, Bool.or_eq_true, Bool.and_eq_true,
                        Bool.not_eq_true'] at *)


theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
   intro s hpre
   try simp_mat
   try simp_defs
   all_goals (cert_prep <;> cert_close)

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
   intro s e ⟨hpre, hinv⟩
   try cert_thin
   try simp_defs
   try cert_facts s
   try cert_floors s
   try simp_mat
   try cert_states s
   all_goals (cert_prep <;> cert_close)

section TS

noncomputable def lts := RM.toTS

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
    intro s hi
    try cert_thin
    try simp_defs
    try cert_facts s
    try cert_floors s
    try simp_mat
    try cert_states s
    all_goals (cert_prep <;> cert_close)

theorem hP : lts.StateSet_isInvariant P := by
    intro s hs
    exact inv_imp_P s (hinv s hs)

noncomputable def safety := rule_globally
  lts
  P
  hP


end TS

=== standalone
import Mathlib.Algebra.BigOperators.Fin
import Core.Basic
import Core.Box
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

-- Budgets and tactics below are generated from the shape of this module and
-- its certificate; see `zrth/lean/proof/tactics.py`.
-- state: Real, 1 slot(s), 3 term(s)
-- predicates: flat, linear
set_option maxRecDepth 4500
set_option maxHeartbeats 2000000

/- Concrete constants -/

@[simp] def c0 : (Mat Real 1 1) := fun _ _ => (5 : Real)

@[simp] def c1 : (Mat Real 1 1) := fun _ _ => (1 : Real)


@[simp] noncomputable def init (extl_n: Unit) : (Mat Real 1 1) :=
  let x0 : (Mat Real 1 1) := c0
  x0

@[simp] noncomputable def update (ctrl: (Mat Real 1 1)) (extl_l: Unit) (extl_n: Unit) : (Mat Real 1 1) :=
  let x0 : (Mat Real 1 1) := c1
  let x1 : (Mat Real 1 1) := (ctrl - x0)
  x1


def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Mat Real 1 1) → Prop := fun s => ((s 0 0) ≤ (5 : Real))

def P : (Mat Real 1 1) → Prop := fun s => ((s 0 0) ≤ (5 : Real))

noncomputable instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

noncomputable def RM : ReactiveModule ((Unit) × (Unit)) ((Mat Real 1 1)) := {
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
}

-- Reduce matrix arithmetic on the goal only (avoids exponential blowup on hypotheses)
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, c0, c1, MatAdd_apply, MatMul_apply, MatZero_apply, Pi.add_apply, mul_Mat_apply, add_Mat_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold definitions everywhere (cheap: no matrix arithmetic reduction)
-- Gives omega/decide access to invariant and property conditions in hypotheses
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, c0, c1] at *; try dsimp at *))

-- Canonicalise the goal: only the steps this module's shapes call for.
macro "cert_prep" : tactic =>
  `(tactic| ((try norm_num at *)))

-- Close it: only the provers this state can use, cheapest first.
macro "cert_close" : tactic =>
  `(tactic| first | contradiction | linarith | (norm_cast; linarith) | (norm_num; done) | (constructor <;> first | linarith) | tauto | (simp_all; done) | (simp_all; linarith) | (simp_all; norm_num; done) | lra_close)

-- Enumerate the state, when it is finite and narrow enough to be worth it.
-- `skip` otherwise. Takes the obligation's own state binder.
macro "cert_states" v:ident : tactic =>
  `(tactic| (skip))

-- Branch conditions cvc5 decided under the invariant, so `split_ifs` does
-- not have to. `skip` unless --smt-tactics=cvc5 found some. Takes the
-- obligation's own state binder; every step is `try`.
macro "cert_facts" v:ident : tactic =>
  `(tactic| (skip))

-- Bridge each floored quantity to a bound on the Real under it, so the
-- closers see the `Int` atom with a sign. `skip` when nothing is floored.
-- Takes the obligation's own state binder; every step is `try`.
macro "cert_floors" v:ident : tactic =>
  `(tactic| (skip))

-- Hypotheses no refutation needed. `skip` otherwise.
macro "cert_thin" : tactic =>
  `(tactic| (skip))

-- Collapse Mat 1 1 types to scalars everywhere (cheap: no Fin.sum_univ)
-- Rewrites Mat 1 1 comparisons, ite through functions, Bool/decide normalization
macro "mat_collapse" : tactic =>
  `(tactic| simp only [Mat_1_1_lt_iff, Mat_1_1_le_iff, Mat_1_1_eq_iff, Mat_1_1_ne_iff,
                        ite_fun_apply,
                        decide_eq_true_eq, Bool.or_eq_true, Bool.and_eq_true,
                        Bool.not_eq_true'] at *)


theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
   intro s hpre
   try simp_mat
   try simp_defs
   all_goals (cert_prep <;> cert_close)

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
   intro s e ⟨hpre, hinv⟩
   try cert_thin
   try simp_defs
   try cert_facts s
   try cert_floors s
   try simp_mat
   try cert_states s
   all_goals (cert_prep <;> cert_close)

section TS

noncomputable def lts := RM.toTS

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
    intro s hi
    try cert_thin
    try simp_defs
    try cert_facts s
    try cert_floors s
    try simp_mat
    try cert_states s
    all_goals (cert_prep <;> cert_close)

theorem hP : lts.StateSet_isInvariant P := by
    intro s hs
    exact inv_imp_P s (hinv s hs)

noncomputable def safety := rule_globally
  lts
  P
  hP


end TS
