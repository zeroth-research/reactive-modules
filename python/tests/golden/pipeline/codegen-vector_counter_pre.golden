=== Certificate/Data.lean
import Core.Basic

def init_pre : ((Mat Int 2 1)) × ((Mat Int 2 1)) → Prop := fun e => ((((e.2) 0 0) ≥ (0 : Int)) ∧ (((e.2) 1 0) ≥ (0 : Int)))

def update_pre : ((Mat Int 2 1)) × ((Mat Int 2 1)) → Prop := fun e => (((e.2) 0 0) ≥ (0 : Int))

def inv : (Mat Int 3 1) → Prop := fun s => ((((s) 0 0) ≥ (0 : Int)) ∧ ((((s) 0 0) ≤ ((s) 1 0)) ∨ (((s) 0 0) ≤ ((s) 2 0))))

def P : (Mat Int 3 1) → Prop := fun s => (((s) 0 0) = (0 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

def ranking : (Mat Int 3 1) → Nat := fun s => (((if (((s) 0 0) = (0 : Int)) then (0 : Int) else (((max ((s) 1 0) ((s) 2 0)) - ((s) 0 0)) + (1 : Int))) : Int)).toNat

=== Certificate/Certificate.lean
import Mathlib.Algebra.BigOperators.Fin
import Core.Basic
import System.System
import Certificate.Data
import ZerothHammer

-- Budgets and tactics below are generated from the shape of this module and
-- its certificate; see `zrth/lean/tactics.py`.
-- state: Bool+Int, 5 slot(s), 10 term(s)
-- predicates: branching, conjunctive, disjunctive, linear, 2 branch point(s) (1 distinct)
set_option maxRecDepth 15000
set_option maxHeartbeats 2000000

def RM : ReactiveModule (((Mat Int 2 1)) × ((Mat Int 2 1))) ((Mat Int 3 1)) := {
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
}

-- Reduce matrix arithmetic on the goal only (avoids exponential blowup on hypotheses)
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, ranking, MatAdd_apply, MatMul_apply, MatZero_apply, Pi.add_apply, mul_Mat_apply, add_Mat_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold definitions everywhere (cheap: no matrix arithmetic reduction)
-- Gives omega/decide access to invariant and property conditions in hypotheses
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, ranking] at *; try dsimp at *))

-- Canonicalise the goal: only the steps this module's shapes call for.
macro "cert_prep" : tactic =>
  `(tactic| ((try split_ifs) <;> (try casesm* _ ∧ _) <;> (try simp only [not_and_or] at *) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)))

-- Close it: only the provers this state can use, cheapest first.
macro "cert_close" : tactic =>
  `(tactic| first | contradiction | omega | linarith | (norm_cast; omega) | (norm_num; done) | (constructor <;> first | omega | linarith) | tauto | (simp_all; done) | (simp_all; omega) | (simp_all; linarith) | (split_ifs at * <;> simp_all <;> omega))

-- Enumerate the state, when it is finite and narrow enough to be worth it.
-- `skip` otherwise. Takes the obligation's own state binder.
macro "cert_states" v:ident : tactic =>
  `(tactic| (skip))

-- Branch conditions cvc5 decided under the invariant, so `split_ifs` does
-- not have to. `skip` unless --smt-tactics=cvc5 found some. Takes the
-- obligation's own state binder; every step is `try`.
macro "cert_facts" v:ident : tactic =>
  `(tactic| (skip))

-- Bridge each floored quantity to a bound on the Real under it, so the
-- closers see the `Int` atom with a sign. `skip` when nothing is floored.
-- Takes the obligation's own state binder; every step is `try`.
macro "cert_floors" v:ident : tactic =>
  `(tactic| (skip))

-- Hypotheses no refutation needed. `skip` otherwise.
macro "cert_thin" : tactic =>
  `(tactic| (skip))

-- Collapse Mat 1 1 types to scalars everywhere (cheap: no Fin.sum_univ)
-- Rewrites Mat 1 1 comparisons, ite through functions, Bool/decide normalization
macro "mat_collapse" : tactic =>
  `(tactic| simp only [Mat_1_1_lt_iff, Mat_1_1_le_iff, Mat_1_1_eq_iff, Mat_1_1_ne_iff,
                        ite_fun_apply,
                        decide_eq_true_eq, Bool.or_eq_true, Bool.and_eq_true,
                        Bool.not_eq_true'] at *)


theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
   intro s hpre
   try simp_mat
   try simp_defs
   all_goals (cert_prep <;> cert_close)

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
   intro s e ⟨hpre, hinv⟩
   try cert_thin
   try simp_defs
   try cert_facts s
   try cert_floors s
   try simp_mat
   try cert_states s
   all_goals (cert_prep <;> cert_close)

section TS

def lts := RM.toTS

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

theorem hrank : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
    intro s s' ⟨hi, hP, htr⟩
    unfold lts at htr; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_update] at htr
    obtain ⟨l, hpre, heq⟩ := htr
    rw [← heq]
    clear heq
    try cert_thin
    try simp_defs
    try cert_facts s
    try cert_floors s
    try simp_mat
    try cert_states s
    all_goals (cert_prep <;> cert_close)

def buchi := rule_buchi
  lts
  P
  inv
  hinv
  ranking
  hrank


end TS

=== standalone
import Mathlib.Algebra.BigOperators.Fin
import Core.Basic
import Core.Box
import ZerothHammer

-- Budgets and tactics below are generated from the shape of this module and
-- its certificate; see `zrth/lean/tactics.py`.
-- state: Bool+Int, 5 slot(s), 10 term(s)
-- predicates: branching, conjunctive, disjunctive, linear, 2 branch point(s) (1 distinct)
set_option maxRecDepth 15000
set_option maxHeartbeats 2000000



@[simp] def init (extl_n: (Mat Int 2 1)) : (Mat Int 3 1) :=
  let x0 : (Mat Int 3 1) := (matVecAffine 3 ([[(0 : Int), (0 : Int)], [(1 : Int), (0 : Int)], [(0 : Int), (1 : Int)]] : List (List Int)) ([(0 : Int), (0 : Int), (0 : Int)] : List Int) extl_n)
  x0

@[simp] def update (ctrl: (Mat Int 3 1)) (extl_l: (Mat Int 2 1)) (extl_n: (Mat Int 2 1)) : (Mat Int 3 1) :=
  let x0 : (Mat Int 1 1) := (matVecAffine 1 ([[(1 : Int), (0 : Int), (0 : Int)]] : List (List Int)) ([(0 : Int)] : List Int) ctrl)
  let x1 : (Mat Int 1 1) := (matVecAffine 1 ([[(0 : Int), (1 : Int), (0 : Int)]] : List (List Int)) ([(0 : Int)] : List Int) ctrl)
  let x2 : (Mat Int 1 1) := (matVecAffine 1 ([[(0 : Int), (0 : Int), (1 : Int)]] : List (List Int)) ([(0 : Int)] : List Int) ctrl)
  let x3 : (Mat Bool 1 1) := (fun _ _ => decide (x0 0 0 < x1 0 0))
  let x4 : (Mat Bool 1 1) := (fun _ _ => decide (x0 0 0 < x2 0 0))
  let x5 : (Mat Bool 1 1) := (fun _ _ => (x3 0 0 || x4 0 0))
  let x6 : (Mat Int 3 1) := (matVecAffine 3 ([[(1 : Int), (0 : Int), (0 : Int)], [(0 : Int), (1 : Int), (0 : Int)], [(0 : Int), (0 : Int), (1 : Int)]] : List (List Int)) ([(1 : Int), (0 : Int), (0 : Int)] : List Int) ctrl)
  let x7 : (Mat Int 3 1) := (matVecAffine 3 ([[(0 : Int), (0 : Int), (0 : Int)], [(0 : Int), (1 : Int), (0 : Int)], [(0 : Int), (0 : Int), (1 : Int)]] : List (List Int)) ([(0 : Int), (0 : Int), (0 : Int)] : List Int) ctrl)
  let x8 : (Mat Int 3 1) := (if x5 0 0 then x6 else x7)
  x8


