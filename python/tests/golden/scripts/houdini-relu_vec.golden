;; --- entry
(set-logic ALL)
(define-fun v_si0_0 () Int 3)
(define-fun v_si0_1 () Int 2)
(define-fun v_si0_2 () Int 1)
(assert (! true :named pre))
(assert (! (not (>= v_si0_0 0)) :named goal))
(check-sat)
;; --- preserved
(set-logic ALL)
(declare-fun v_s0_0 () Int)
(declare-fun v_s0_1 () Int)
(declare-fun v_s0_2 () Int)
(define-fun v_sp0_0 () Int (ite (>= v_s0_0 1) (+ (- 1) v_s0_0) 0))
(define-fun v_sp0_1 () Int (ite (>= v_s0_1 1) (+ (- 1) v_s0_1) 0))
(define-fun v_sp0_2 () Int (ite (>= v_s0_2 1) (+ (- 1) v_s0_2) 0))
(assert (! (>= v_s0_0 0) :named h0))
(assert (! true :named pre))
(assert (! (not (>= v_sp0_0 0)) :named goal))
(check-sat)
;; --- implies
(set-logic ALL)
(declare-fun v_s0_0 () Int)
(assert (! (>= v_s0_0 0) :named h0))
(assert (! (not (= v_s0_0 0)) :named goal))
(check-sat)
