;; --- entry
(set-logic ALL)
(define-fun v_si0 () Int 100)
(assert (! true :named pre))
(assert (! (not (and (<= 0 v_si0) (<= v_si0 100))) :named goal))
(check-sat)
;; --- preserved
(set-logic ALL)
(declare-fun v_s0 () Int)
(define-fun v_sp0 () Int (ite (= v_s0 0) 100 (- v_s0 1)))
(assert (! (<= 0 v_s0) :named h0))
(assert (! (<= v_s0 100) :named h1))
(assert (! true :named pre))
(assert (! (not (and (<= 0 v_sp0) (<= v_sp0 100))) :named goal))
(check-sat)
;; --- implies
(set-logic ALL)
(declare-fun v_s0 () Int)
(assert (! (<= 0 v_s0) :named h0))
(assert (! (<= v_s0 100) :named h1))
(assert (! (not (= v_s0 0)) :named goal))
(check-sat)
;; --- drops
(set-logic ALL)
(declare-fun v_s0 () Int)
(define-fun v_sp0 () Int (ite (= v_s0 0) 100 (- v_s0 1)))
(assert (! (<= 0 v_s0) :named h0))
(assert (! (<= v_s0 100) :named h1))
(assert (! (not (= v_s0 0)) :named notP))
(assert (! true :named pre))
(assert (! (not (< (ite (>= v_sp0 0) v_sp0 0) (ite (>= v_s0 0) v_s0 0))) :named goal))
(check-sat)
