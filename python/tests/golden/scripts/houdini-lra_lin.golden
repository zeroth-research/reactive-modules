;; --- entry
(set-logic ALL)
(define-fun v_si0 () Real 5.0)
(assert (! true :named pre))
(assert (! (not (and (<= 0.0 v_si0) (<= v_si0 5.0))) :named goal))
(check-sat)
;; --- preserved
(set-logic ALL)
(declare-fun v_s0 () Real)
(define-fun v_sp0 () Real (ite (> v_s0 0.0) (- v_s0 1.0) 5.0))
(assert (! (<= 0.0 v_s0) :named h0))
(assert (! (<= v_s0 5.0) :named h1))
(assert (! true :named pre))
(assert (! (not (and (<= 0.0 v_sp0) (<= v_sp0 5.0))) :named goal))
(check-sat)
;; --- implies
(set-logic ALL)
(declare-fun v_s0 () Real)
(assert (! (<= 0.0 v_s0) :named h0))
(assert (! (<= v_s0 5.0) :named h1))
(assert (! (not (= v_s0 0.0)) :named goal))
(check-sat)
;; --- drops
(set-logic ALL)
(declare-fun v_s0 () Real)
(define-fun v_sp0 () Real (ite (> v_s0 0.0) (- v_s0 1.0) 5.0))
(assert (! (<= 0.0 v_s0) :named h0))
(assert (! (<= v_s0 5.0) :named h1))
(assert (! (not (= v_s0 0.0)) :named notP))
(assert (! true :named pre))
(assert (! (not (let ((_let_1 (to_int v_s0))) (let ((_let_2 (to_int v_sp0))) (< (ite (>= _let_2 0) _let_2 0) (ite (>= _let_1 0) _let_1 0))))) :named goal))
(check-sat)
