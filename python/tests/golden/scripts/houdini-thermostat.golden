;; --- entry
(set-logic ALL)
(define-fun v_si0 () Real 20.0)
(define-fun v_si1 () Bool false)
(assert (! true :named pre))
(assert (! (not (and (=> v_si1 (<= v_si0 23.0)) (=> (not v_si1) (<= 17.0 v_si0)))) :named goal))
(check-sat)
;; --- preserved
(set-logic ALL)
(declare-fun v_s0 () Real)
(declare-fun v_s1 () Bool)
(define-fun v_sp0 () Real (let ((_let_1 (+ (* 0.875 v_s0) 0.0))) (ite v_s1 (+ _let_1 3.75) (+ _let_1 1.25))))
(define-fun v_sp1 () Bool (ite (<= v_s0 18.0) true (ite (>= v_s0 22.0) false v_s1)))
(assert (! (=> v_s1 (<= v_s0 23.0)) :named h0))
(assert (! (=> (not v_s1) (<= 17.0 v_s0)) :named h1))
(assert (! true :named pre))
(assert (! (not (and (=> v_sp1 (<= v_sp0 23.0)) (=> (not v_sp1) (<= 17.0 v_sp0)))) :named goal))
(check-sat)
;; --- implies
(set-logic ALL)
(declare-fun v_s0 () Real)
(declare-fun v_s1 () Bool)
(assert (! (=> v_s1 (<= v_s0 23.0)) :named h0))
(assert (! (=> (not v_s1) (<= 17.0 v_s0)) :named h1))
(assert (! (not (and (>= v_s0 15.0) (<= v_s0 25.0))) :named goal))
(check-sat)
