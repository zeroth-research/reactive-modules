(declare-fun v_s0 () Real)
(declare-fun v_s1 () Bool)
(declare-fun N0 () Real)
(assert (= N0 (let ((_let_1 (+ (* 0.875 v_s0) 0.0))) (ite v_s1 (+ _let_1 3.75) (+ _let_1 1.25)))))
(declare-fun N1 () Bool)
(assert (= N1 (ite (<= v_s0 18.0) true (ite (>= v_s0 22.0) false v_s1))))
(declare-fun I0 () Real)
(assert (= I0 20.0))
(declare-fun I1 () Bool)
(assert (= I1 false))
(declare-fun PRE () Bool) (assert (= PRE true))
(declare-fun IPRE () Bool) (assert (= IPRE true))
